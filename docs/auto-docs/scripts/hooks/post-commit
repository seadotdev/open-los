#!/bin/bash

# Post-Commit Hook for Open LOS Auto-Documentation
# This hook automatically generates release logs after each commit.
#
# Installation:
#   cp docs/auto-docs/scripts/hooks/post-commit .git/hooks/post-commit
#   chmod +x .git/hooks/post-commit

set -e

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

echo -e "${BLUE}[Auto-Docs]${NC} Post-commit hook triggered"

# Get the repo root
REPO_ROOT=$(git rev-parse --show-toplevel)
SCRIPT_PATH="$REPO_ROOT/docs/auto-docs/scripts/generate-docs.ts"

# Check if the generator script exists
if [ ! -f "$SCRIPT_PATH" ]; then
    echo -e "${YELLOW}[Auto-Docs]${NC} Generator script not found, skipping documentation generation"
    exit 0
fi

# Get the latest commit
COMMIT_SHA=$(git rev-parse HEAD)
COMMIT_MSG=$(git log -1 --format="%s")

echo -e "${BLUE}[Auto-Docs]${NC} Generating documentation for commit: ${COMMIT_SHA:0:7}"
echo -e "${BLUE}[Auto-Docs]${NC} Message: $COMMIT_MSG"

# Check if this is a documentation-only commit (skip to avoid loops)
if [[ "$COMMIT_MSG" == *"[auto-docs]"* ]] || [[ "$COMMIT_MSG" == *"[skip-docs]"* ]]; then
    echo -e "${YELLOW}[Auto-Docs]${NC} Skipping documentation generation (auto-docs or skip-docs commit)"
    exit 0
fi

# Check if tsx is available
if ! command -v npx &> /dev/null; then
    echo -e "${YELLOW}[Auto-Docs]${NC} npx not found, skipping documentation generation"
    exit 0
fi

# Generate release log only (quick operation)
echo -e "${BLUE}[Auto-Docs]${NC} Generating release log..."

cd "$REPO_ROOT"
npx tsx "$SCRIPT_PATH" --commit "$COMMIT_SHA" --type release 2>/dev/null || {
    echo -e "${YELLOW}[Auto-Docs]${NC} Release log generation failed (non-blocking)"
    exit 0
}

echo -e "${GREEN}[Auto-Docs]${NC} Release log generated successfully"

# Show generated file location
TIMESTAMP=$(git log -1 --format="%aI" | cut -d'T' -f1)
SHORT_SHA=$(git rev-parse --short HEAD)
echo -e "${GREEN}[Auto-Docs]${NC} Output: docs/auto-docs/generated/releases/${TIMESTAMP}-${SHORT_SHA}.md"

exit 0
