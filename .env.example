PORT=3000
DB_PATH=:memory:
# Comma-separated allowlist. Use "*" or leave empty to allow all.
CORS_ORIGINS=http://localhost:3000

# Demo mode (enables /v1/demo/provision and sandbox tenants)
DEMO_MODE=false
DEMO_SECRET=demo-secret-change-me
DEMO_TENANT_TTL=86400
DEMO_MAX_TENANTS=1000
DEMO_API_URL=

# LLM keys (optional — only needed for underwriting evaluate)
# ANTHROPIC_API_KEY=
# OPENROUTER_API_KEY=
# LOS_DEFAULT_MODEL=claude-sonnet-4-5-20250929

# Web frontend
NEXT_PUBLIC_API_URL=http://localhost:3000
