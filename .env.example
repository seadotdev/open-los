PORT=3000
DB_PATH=:memory:
# Comma-separated allowlist. Use "*" or leave empty to allow all.
CORS_ORIGINS=http://localhost:3000

# Optional LLM providers
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=
# AI_GATEWAY_API_KEY=

# Optional defaults
# LOS_DEFAULT_PROVIDER=vercel
# LOS_DEFAULT_MODEL=anthropic/claude-sonnet-4.5

# Optional base URL overrides
# OPENAI_BASE_URL=
# LOS_OPENROUTER_BASE_URL=
# LOS_VERCEL_BASE_URL=

# Optional per-function routing
# LOS_LLM_ROUTES={"underwrite":{"provider":"vercel","model":"anthropic/claude-sonnet-4.5","fallbackModels":["openai/gpt-5.2"]},"chat":{"provider":"openrouter","model":"anthropic/claude-sonnet-4-5-20250929"},"spread":{"provider":"openai","model":"gpt-4.1-mini"}}
