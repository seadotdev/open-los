{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-los.dev/schemas/screening-result.schema.json",
  "title": "ScreeningResult",
  "type": "object",
  "required": ["id", "entity_id", "source", "status", "initiated_by", "created_at"],
  "properties": {
    "id": { "type": "string", "format": "uuid" },
    "entity_id": { "type": "string", "format": "uuid" },
    "source": {
      "type": "string",
      "enum": ["dunl_spiq", "companies_house", "gleif_lei", "opencorporates", "internal"]
    },
    "status": {
      "type": "string",
      "enum": ["pending", "matched", "partial", "unmatched", "confirmed", "rejected", "error"]
    },
    "external_id": { "type": "string" },
    "external_name": { "type": "string" },
    "match_confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "match_method": {
      "type": "string",
      "enum": ["exact_id", "name_fuzzy", "qmd_hybrid", "lei_match"]
    },
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["external_id", "name", "confidence"],
        "properties": {
          "external_id": { "type": "string" },
          "name": { "type": "string" },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "identifiers": { "type": "object" },
          "metadata": { "type": "object" }
        }
      }
    },
    "matched_identifiers": { "type": "object" },
    "risk_signals": {
      "type": "object",
      "properties": {
        "sanctions_hit": { "type": "boolean" },
        "pep_hit": { "type": "boolean" },
        "adverse_media": { "type": "boolean" },
        "jurisdiction_risk": { "type": "string" }
      }
    },
    "initiated_by": { "type": "string" },
    "reviewed_by": { "type": "string" },
    "reviewed_at": { "type": "string", "format": "date-time" },
    "review_notes": { "type": "string" },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false
}
