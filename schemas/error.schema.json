{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-los.dev/schemas/error.schema.json",
  "title": "ApiError",
  "type": "object",
  "required": ["error"],
  "properties": {
    "error": {
      "type": "object",
      "required": ["code", "message"],
      "properties": {
        "code": {
          "type": "string",
          "description": "Machine-readable error code, e.g. STAGE_GUARD_FAILED, VALIDATION_ERROR, NOT_FOUND"
        },
        "message": {
          "type": "string",
          "description": "Human-readable error message"
        },
        "details": {
          "type": "object",
          "additionalProperties": true,
          "description": "Additional context about the error"
        },
        "retryable": {
          "type": "boolean",
          "default": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
