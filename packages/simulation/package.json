{
  "name": "@open-los/simulation",
  "version": "0.1.0",
  "description": "Lending business simulation suite for capability testing",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "ci:fmt": "node -e \"\"",
    "dev": "tsx watch src/cli.ts",
    "simulate": "tsx src/cli.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "crm-test": "tsx src/crm-test/cli.ts run",
    "crm-test:list": "tsx src/crm-test/cli.ts list-tasks",
    "crm-test:verbose": "tsx src/crm-test/cli.ts run --verbose"
  },
  "dependencies": {
    "@open-los/core": "*",
    "yaml": "^2.3.4",
    "chalk": "^5.3.0",
    "ora": "^8.0.1",
    "commander": "^12.0.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vitest": "^1.2.0"
  }
}
